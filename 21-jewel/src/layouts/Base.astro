---
import '../styles/tokens.css';
import '../styles/base.css';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { doc } from '../lib/content';
import { heroScript, themeScript } from '../lib/hero';

interface Props {
  page: string;               // key in site.yaml seo.pages
  jsonLd?: object[];
  noindex?: boolean;
}
const { page, jsonLd = [], noindex = false } = Astro.props;
const site = await doc('site');
const seo = site.seo.pages[page];
if (!seo) throw new Error(`site.yaml seo.pages is missing "${page}"`);
const canonical = new URL(Astro.url.pathname, site.brand.url).href;
const ogImage = new URL(site.seo.og_image, site.brand.url).href;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript}></script>
    <script is:inline set:html={heroScript(site.heroTest)}></script>
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F3EFE6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1612" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <Fonts />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{site.nav.skip}</a>
    <Header site={site} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer site={site} />
    <script>
      import { initAnalytics } from '../lib/analytics';
      initAnalytics();
    </script>
  </body>
</html>
