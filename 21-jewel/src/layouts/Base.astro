---
import '../styles/tokens.css';
import '../styles/base.css';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { doc } from '../lib/content';
import { heroScript } from '../lib/hero';

interface Props {
  page: string;               // key in site.yaml seo.pages
  jsonLd?: object[];
  noindex?: boolean;
  stickyBar?: boolean;        // mobile call/audit bar (off on the audit page itself)
}
const { page, jsonLd = [], noindex = false, stickyBar = true } = Astro.props;
const site = await doc('site');
const seo = site.seo.pages[page];
if (!seo) throw new Error(`site.yaml seo.pages is missing "${page}"`);
// Clean URL to match the sitemap and Cloudflare: /offers.html → /offers, /index.html → /.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(cleanPath, site.brand.url).href;
const ogImage = new URL(site.seo.og_image, site.brand.url).href;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={heroScript(site.heroTest)}></script>
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#F3EFE6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand.legal_name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:locale" content="en_US" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.seo.og_image_alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.seo.og_image_alt} />
    <Fonts />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class:list={{ 'has-sticky': stickyBar }}>
    <a class="skip-link" href="#main">{site.nav.skip}</a>
    <Header site={site} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer site={site} />
    {stickyBar && <StickyBar site={site} />}
    <script>
      import { initAnalytics } from '../lib/analytics';
      initAnalytics();
    </script>
  </body>
</html>
