---
import type { SiteData } from '../lib/content';
import MobileMenu from './MobileMenu.astro';
interface Props { site: SiteData }
const { site } = Astro.props;
const { nav } = site;
---
<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="/" aria-label={nav.home_label}>{site.brand.name}</a>
    <nav class="desktop-nav" aria-label="Main">
      <ul role="list">
        {nav.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="btn btn-primary cta" href={nav.cta.href} data-event="nav_scorecard_click"><span class="long">{nav.cta.label}</span><span class="short" aria-hidden="true">{nav.cta_short}</span></a>
      <MobileMenu nav={nav} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--bg); border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: var(--space-5); min-height: 72px; }
  .wordmark {
    font-family: var(--font-display); font-weight: 600; font-size: 22px;
    color: var(--ink); text-decoration: none; white-space: nowrap;
    min-height: 44px; display: inline-flex; align-items: center;
  }
  .desktop-nav { margin-left: auto; }
  .desktop-nav ul { display: flex; gap: var(--space-5); }
  .desktop-nav a {
    color: var(--ink); text-decoration: none; font-weight: 500; font-size: 15px;
    min-height: 44px; display: inline-flex; align-items: center;
  }
  .desktop-nav a:hover { color: var(--accent-text); }
  .actions { display: flex; align-items: center; gap: var(--space-2); }
  .cta { padding: 10px 16px; font-size: 15px; }
  @media (max-width: 759.98px) {
    .desktop-nav { display: none; }
    .actions { margin-left: auto; }
    .bar { gap: var(--space-3); min-height: 64px; }
    .wordmark { font-size: 20px; }
    .cta { padding: 10px 12px; font-size: 14px; white-space: nowrap; }
  }
  .short { display: none; }
  @media (max-width: 399.98px) {
    .long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .short { display: inline; }
  }
</style>
