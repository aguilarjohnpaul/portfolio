---
import { priceLabel, type Offer, type OffersData } from '../lib/content';
interface Props { offer: Offer; labels: OffersData['page']['labels']; cal: string; showFounding: boolean }
const { offer, labels, cal, showFounding } = Astro.props;
const facts = [
  { label: labels.needs, value: offer.needs },
  { label: labels.your_time, value: offer.your_time },
  { label: labels.timeline, value: offer.timeline },
  { label: labels.terms, value: offer.terms },
  { label: labels.guarantee, value: offer.guarantee },
].filter((f) => f.value);
const cta = offer.button ?? { label: labels.book_button, href: cal };
---
<article id={offer.id} class="card detail" aria-labelledby={`${offer.id}-h`} data-offer-view={offer.id}>
  <header class="head">
    <p class="price">{offer.type} · {priceLabel(offer, labels)}</p>
    <h2 id={`${offer.id}-h`}>{offer.name}</h2>
    <p class="lead">{offer.one_liner}</p>
  </header>
  <div class="body">
    <div class="col">
      <h3>{labels.for}</h3>
      <p>{offer.for}</p>
      <h3 class="gap">{labels.get}</h3>
      <ul class="list">
        {offer.get.map((g) => typeof g === 'string'
          ? <li>{g}</li>
          : <li>{g.heading}<ul class="list sub">{g.items.map((i) => <li>{i}</li>)}</ul></li>)}
      </ul>
      {offer.note && <p class="muted note">{offer.note}</p>}
    </div>
    <dl class="col facts">
      {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
    </dl>
  </div>
  <div class="btn-row actions">
    <a class="btn btn-primary" href={cta.href} data-event="cta_click" data-prop-location={`offers-${offer.id}`} data-prop-target={cta.href}>{cta.label}</a>
    {showFounding && !offer.free && (
      <a class="secondary" href="/founding-clients" data-event="cta_click" data-prop-location={`offers-${offer.id}`} data-prop-target="/founding-clients">{labels.founding_link}</a>
    )}
  </div>
</article>

<style>
  .detail { display: grid; gap: var(--space-5); padding: var(--space-6); scroll-margin-top: 96px; }
  .head { display: grid; gap: var(--space-3); }
  .price { font-size: var(--micro); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-text); }
  h2 { font-size: var(--h3); }
  h3, dt { font-family: var(--font-body); font-size: var(--small); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: var(--space-2); }
  .gap { margin-top: var(--space-5); }
  .body { display: grid; gap: var(--space-6); }
  .sub { margin-top: var(--space-2); }
  .facts { display: grid; gap: var(--space-4); align-content: start; margin: 0; }
  dd { margin: 0; }
  .note { margin-top: var(--space-3); font-size: var(--small); }
  .actions { align-items: center; }
  .secondary { font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; padding-inline: var(--space-2); }
  @media (min-width: 760px) { .body { grid-template-columns: 1.4fr 1fr; } }
</style>
