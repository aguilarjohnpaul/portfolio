---
import type { HomeData } from '../lib/content';
interface Props { sample: HomeData['sample'] }
const { sample } = Astro.props;
---
<figure class="sample" aria-label={sample.label}>
  <p class="tag">{sample.label}</p>
  <p class="score"><span class="num">{sample.score}</span><span class="of"> / 100 {sample.score_label}</span></p>
  <ul role="list" class="bars">
    {sample.bars.map((b) => (
      <li class:list={{ weakest: b.weakest }}>
        <div class="row"><span>{b.label}</span><span class="val">{b.value}</span></div>
        <div class="track" aria-hidden="true"><div class="fill" style={`width:${b.value}%`}></div></div>
      </li>
    ))}
  </ul>
  <figcaption class="small">{sample.footer}</figcaption>
</figure>

<style>
  .sample {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-hero);
    padding: var(--space-6); display: grid; gap: var(--space-5);
  }
  .tag { font-size: var(--micro); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .score { display: flex; align-items: baseline; gap: var(--space-2); flex-wrap: wrap; }
  .num { font-family: var(--font-display); font-size: 64px; line-height: 1; color: var(--data); font-weight: 600; }
  .of { color: var(--muted); font-size: var(--small); }
  .bars { display: grid; gap: var(--space-4); }
  .row { display: flex; justify-content: space-between; font-size: var(--small); font-weight: 600; margin-bottom: 6px; }
  .val { color: var(--data); }
  .weakest .val { color: var(--accent-text); }
  .track { height: 10px; background: var(--line); border-radius: 99px; overflow: hidden; }
  .fill { height: 100%; background: var(--data); border-radius: inherit; }
  .weakest .fill { background: var(--accent); }
  figcaption { border-top: 1px solid var(--line); padding-top: var(--space-4); font-weight: 500; }
</style>
