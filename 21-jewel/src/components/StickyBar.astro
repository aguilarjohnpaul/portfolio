---
// Mobile-only bar pinned to the bottom: call, or request the audit (Change 03 §3).
// Hidden while any form is on screen so it never covers a field, and not rendered on /audit at all.
import type { SiteData } from '../lib/content';
interface Props { site: SiteData }
const { site } = Astro.props;
const { sticky, brand } = site;
---
<div class="sticky-bar" id="sticky-bar" data-sticky-bar>
  <a class="call" href={`tel:${brand.phone_href}`} data-event="call_click" data-prop-location="sticky">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6.6 3h3.1l1.6 4-2 1.3a11.5 11.5 0 0 0 6.4 6.4l1.3-2 4 1.6v3.1A2.6 2.6 0 0 1 18.4 20 15.4 15.4 0 0 1 4 5.6 2.6 2.6 0 0 1 6.6 3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
    <span>{sticky.call}</span>
  </a>
  <a class="go" href={sticky.cta.href} data-event="cta_click" data-prop-location="sticky" data-prop-target={sticky.cta.href}>{sticky.cta.label}</a>
</div>

<style>
  .sticky-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: none; grid-template-columns: 1fr 1fr; gap: 1px;
    background: var(--line); border-top: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom);
    transition: transform var(--ease);
  }
  .sticky-bar[data-hidden] { transform: translateY(110%); }
  .sticky-bar a {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    min-height: 56px; padding: 0 var(--space-3); font-weight: 600; font-size: 15px; text-decoration: none;
  }
  .call { background: var(--surface); color: var(--ink); }
  .go { background: var(--btn-bg); color: var(--btn-fg); }
  @media (max-width: 759.98px) {
    .sticky-bar { display: grid; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-bar]');
  const forms = document.querySelectorAll('form');
  if (bar && forms.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
      if (visible.size) bar.setAttribute('data-hidden', ''); else bar.removeAttribute('data-hidden');
    }, { rootMargin: '0px 0px -56px 0px' });
    forms.forEach((f) => io.observe(f));
  }
</script>
