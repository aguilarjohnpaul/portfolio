---
import type { HomeData } from '../lib/content';
interface Props { part: HomeData['your_part'] }
const { part } = Astro.props;
---
<section class="section section-surface" aria-labelledby="part-h">
  <div class="container inner">
    <h2 id="part-h">{part.heading}</h2>
    <ul role="list" class="items">
      {part.items.map((t) => (
        <li>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span>{t}</span>
        </li>
      ))}
    </ul>
    <p class="closing">{part.closing}</p>
  </div>
</section>

<style>
  .inner { display: grid; gap: var(--space-5); max-width: 860px; }
  .items { display: grid; gap: var(--space-3); }
  .items li { display: flex; gap: var(--space-3); align-items: flex-start; font-size: var(--lead); line-height: 1.45; }
  svg { flex: none; color: var(--data); margin-top: 3px; }
  .closing { font-weight: 600; font-size: var(--lead); }
</style>
