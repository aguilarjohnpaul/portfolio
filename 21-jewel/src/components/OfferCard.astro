---
import type { Offer } from '../lib/content';
interface Props { offer: Offer; price: string; seeDetails: string }
const { offer, price, seeDetails } = Astro.props;
const cta = offer.button ?? { label: seeDetails, href: `/offers#${offer.id}` };
---
<li class="card offer">
  <p class="price">{price}</p>
  <h3>{offer.name}</h3>
  <p class="muted">{offer.one_liner}</p>
  <a class:list={['go', { 'btn btn-primary': !!offer.button }]} href={cta.href}
    data-event="cta_click" data-prop-location={`offer-card-${offer.id}`} data-prop-target={cta.href}>
    {cta.label}{!offer.button && <span class="visually-hidden">: {offer.name}</span>}
  </a>
</li>

<style>
  .offer { display: grid; gap: var(--space-3); align-content: start; grid-template-rows: auto auto 1fr auto; }
  .price { font-size: var(--micro); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-text); }
  h3 { font-size: 20px; }
  .go:not(.btn) { font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  .btn { font-size: 15px; padding: 12px 16px; }
</style>
