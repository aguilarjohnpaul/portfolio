---
import { fill, flagOn, type SiteData } from '../lib/content';
interface Props { site: SiteData }
const { site } = Astro.props;
const { brand, footer, flags } = site;
const industries = footer.industries.filter((l) => flagOn(flags, l.flag));
const links = footer.links.filter((l) => flagOn(flags, l.flag));
---
<footer class="site-footer">
  <div class="container inner">
    <div class="cols">
      <div class="col brand">
        <p class="name">{brand.legal_name}</p>
        <p class="tagline">{brand.tagline}</p>
        <p><a class="contact" href={`tel:${brand.phone_href}`} data-event="call_click" data-prop-location="footer">{brand.phone}</a></p>
        <p><a class="contact" href={`mailto:${brand.email}`} data-event="email_click" data-prop-location="footer">{brand.email}</a></p>
        <p class="small muted">{brand.location}</p>
      </div>
      <nav class="col" aria-labelledby="ft-who">
        <p class="col-h" id="ft-who">{footer.who_heading}</p>
        <ul role="list">{industries.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="col" aria-labelledby="ft-more">
        <p class="col-h" id="ft-more">{footer.links_heading}</p>
        <ul role="list">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    </div>
    <div class="bottom">
      <p class="small muted">{fill(footer.bottom, { year: new Date().getFullYear() })}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--surface); padding-block: var(--space-7); }
  .inner { display: grid; gap: var(--space-6); }
  .cols { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .col { display: grid; gap: var(--space-2); align-content: start; }
  .name { font-family: var(--font-display); font-weight: 600; font-size: 22px; }
  .tagline { font-weight: 600; color: var(--accent-text); }
  .col-h { font-size: var(--micro); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .col ul { display: grid; }
  .col li a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--small); }
  .brand a { overflow-wrap: anywhere; }
  .contact { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-4); border-top: 1px solid var(--line); padding-top: var(--space-5); }
</style>
