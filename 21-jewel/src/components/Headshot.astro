---
// JP's photo when public/jp.jpg is set in the YAML, otherwise the monogram. Never a placeholder string.
import Monogram from './Monogram.astro';
interface Props { photo: string; alt: string; eager?: boolean }
const { photo, alt, eager = false } = Astro.props;
const src = photo.trim();
---
{src
  ? <img class="photo" src={src} alt={alt} width="480" height="600" loading={eager ? 'eager' : 'lazy'} />
  : <Monogram label={alt} />}

<style>
  .photo { width: 100%; max-width: 360px; aspect-ratio: 4 / 5; border-radius: var(--radius-card); object-fit: cover; }
</style>
