---
// JP's photo, or a labeled placeholder until public/jp.jpg is added.
interface Props { photo: string; alt: string; eager?: boolean }
const { photo, alt, eager = false } = Astro.props;
const src = photo.trim();
const isPlaceholder = /^\[.*\]$/.test(alt);
---
{src
  ? <img class="photo" src={src} alt={isPlaceholder ? 'JP, founder of 21 Jewel' : alt} width="480" height="600" loading={eager ? 'eager' : 'lazy'} />
  : <div class="photo placeholder" role="img" aria-label={alt}><span>{alt}</span></div>}

<style>
  .photo { width: 100%; max-width: 360px; aspect-ratio: 4 / 5; border-radius: var(--radius-card); object-fit: cover; }
  .placeholder {
    background: var(--surface); border: 1px dashed var(--line);
    display: grid; place-items: center; color: var(--muted); font-size: var(--small); font-weight: 600;
    padding: var(--space-4); text-align: center;
  }
</style>
