---
// Closing call to action for service, industry, learn and pricing pages: audit button, phone, trust chips.
import type { SiteData } from '../lib/content';
import TrustStrip from './TrustStrip.astro';
interface Props { site: SiteData; heading: string; body?: string; label: string; href?: string; callLabel: string; location: string }
const { site, heading, body, label, href = '/audit', callLabel, location } = Astro.props;
---
<section class="section section-surface" aria-labelledby={`cta-${location}`}>
  <div class="container inner">
    <h2 id={`cta-${location}`}>{heading}</h2>
    {body && <p class="lead">{body}</p>}
    <div class="actions">
      <a class="btn btn-primary" href={href} data-event="cta_click" data-prop-location={location} data-prop-target={href}>{label}</a>
      <a class="text-link" href={`tel:${site.brand.phone_href}`} data-event="call_click" data-prop-location={location}>{callLabel} {site.brand.phone}</a>
    </div>
    <TrustStrip trust={site.trust} />
  </div>
</section>

<style>
  .inner { display: grid; gap: var(--space-4); justify-items: center; text-align: center; }
  .inner p { margin-inline: auto; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-3) var(--space-5); }
  .text-link { font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; white-space: nowrap; }
  .inner :global(.chips) { justify-content: center; }
</style>
