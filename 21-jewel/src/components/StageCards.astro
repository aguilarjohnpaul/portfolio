---
import type { HomeData } from '../lib/content';
interface Props { how: HomeData['how'] }
const { how } = Astro.props;
---
<section id="how" class="section" aria-labelledby="how-h">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{how.eyebrow}</p>
      <h2 id="how-h">{how.heading}</h2>
    </div>
    <ol role="list" class="grid carousel" tabindex="0" aria-labelledby="how-h">
      {how.steps.map((s, i) => (
        <li class="card stage">
          <p class="n" aria-hidden="true">{i + 1}</p>
          <h3><span class="visually-hidden">{i + 1}. </span>{s.name}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="framework">{how.framework}</p>
  </div>
</section>

<style>
  .stage { display: grid; gap: var(--space-3); align-content: start; }
  .n {
    font-family: var(--font-display); font-weight: 600; font-size: 20px; color: var(--accent-text);
    width: 40px; height: 40px; border: 2px solid var(--accent); border-radius: 50%;
    display: grid; place-items: center;
  }
  .framework { margin-top: var(--space-5); font-family: var(--font-display); font-weight: 600; font-size: var(--h3); color: var(--accent-text); }
</style>
