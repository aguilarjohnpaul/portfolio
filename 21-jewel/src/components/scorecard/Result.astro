---
import type { ScorecardContent } from '../../lib/content';
interface Props { sc: ScorecardContent }
const { sc } = Astro.props;
---
<div class="sc-result" data-state="result" hidden>
  <section class="card result-card" aria-labelledby="result-h" tabindex="-1" data-result-focus>
    <p class="eyebrow" id="result-h">{sc.result.eyebrow}</p>
    <p class="score"><span class="num" data-total>0</span><span class="of">{sc.result.score_suffix}</span></p>
    <div class="track score-track" aria-hidden="true"><div class="fill" data-score-fill></div></div>
    <h2 class="band" data-band></h2>
    <p class="muted" data-band-body></p>
    <div class="leak">
      <p class="label" data-fixes-label>{sc.result.fixes_label}</p>
      <ol class="fixes" data-fixes></ol>
      <p class="perfect" data-perfect hidden>{sc.result.perfect}</p>
    </div>
    <div>
      <a class="btn btn-primary" href={sc.result.review_button.href}
        data-event="cta_click" data-prop-location="scorecard-result" data-prop-target={sc.result.review_button.href}>{sc.result.review_button.label}</a>
    </div>
  </section>
  <button type="button" class="link-btn restart" data-action="restart">{sc.result.restart}</button>
</div>
