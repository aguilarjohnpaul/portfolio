---
// Pricing preview on the homepage (Change 03 §5.5): the audit first, then the three brackets.
import { ladder, priceLabel, type HomeData, type OffersData } from '../lib/content';
import OfferCard from './OfferCard.astro';
interface Props { intro: HomeData['offers']; data: OffersData }
const { intro, data } = Astro.props;
---
<section id="offers" class="section section-surface" aria-labelledby="offers-h">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{intro.eyebrow}</p>
      <h2 id="offers-h">{intro.heading}</h2>
    </div>
    <ol role="list" class="ladder carousel" tabindex="0" aria-labelledby="offers-h">
      {ladder(data).map((o) => <OfferCard offer={o} price={priceLabel(o, data.page.labels)} seeDetails={data.page.labels.see_details} />)}
    </ol>
    <p class="rule">{data.page.ladder_rule}</p>
    <p><a class="more" href={intro.link.href} data-event="cta_click" data-prop-location="home-pricing" data-prop-target={intro.link.href}>{intro.link.label}</a></p>
  </div>
</section>

<style>
  @media (min-width: 760px) {
    .ladder { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  }
  .rule { margin-top: var(--space-5); font-weight: 600; }
  .more { font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
</style>
