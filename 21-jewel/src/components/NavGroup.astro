---
// One desktop dropdown: a button that opens a list. Opens on hover, focus-within and click; closes on Escape or outside click.
interface Props { group: { label: string; links: { label: string; href: string }[] } }
const { group } = Astro.props;
const id = `menu-${group.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
<li class="group">
  <button type="button" class="trigger" aria-expanded="false" aria-controls={id}>
    {group.label}
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <ul id={id} role="list" class="menu">
    {group.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
  </ul>
</li>

<style>
  .group { position: relative; }
  .trigger {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding-inline: var(--space-2);
    background: none; border: 0; cursor: pointer; font-weight: 500; font-size: 15px; color: var(--ink);
  }
  .trigger:hover, .group:focus-within .trigger { color: var(--accent-text); }
  .menu {
    position: absolute; top: 100%; left: 0; min-width: 260px; z-index: 60;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card);
    padding: var(--space-2); display: none;
  }
  .group:hover .menu, .group:focus-within .menu, .trigger[aria-expanded="true"] + .menu { display: grid; }
  .menu a {
    display: flex; align-items: center; min-height: 44px; padding: 0 var(--space-3);
    color: var(--ink); text-decoration: none; font-weight: 500; font-size: 15px; border-radius: 6px;
  }
  .menu a:hover, .menu a:focus-visible { background: var(--bg); color: var(--accent-text); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.group .trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.group .trigger').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.group')) document.querySelectorAll('.group .trigger').forEach((b) => b.setAttribute('aria-expanded', 'false'));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll<HTMLButtonElement>('.group .trigger[aria-expanded="true"]').forEach((b) => { b.setAttribute('aria-expanded', 'false'); b.focus(); });
  });
</script>
