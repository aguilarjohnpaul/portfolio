---
// /terms. Built only when site.yaml flags.showTerms is true. Needs a lawyer review first. Not legal advice.
import Base from '../../layouts/Base.astro';
import { doc } from '../../lib/content';
const [site, pages] = await Promise.all([doc('site'), doc('pages')]);
const t = pages.terms;
const updated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/Chicago' });
---
<Base page="terms">
  <div class="container page-head">
    <h1>{t.heading}</h1>
    <p class="small muted">{t.updated_label}: {updated}</p>
    <p class="lead">{t.intro}</p>
  </div>
  <section class="section">
    <ol class="container prose">
      {t.sections.map((s) => (
        <li class="stack item">
          <h2 class="h3">{s.title}</h2>
          <p>{s.body}</p>
        </li>
      ))}
      <li class="stack item">
        <p>{t.contact} <a href={`mailto:${site.brand.email}`} data-event="email_click" data-prop-location="terms">{site.brand.email}</a>.</p>
      </li>
    </ol>
  </section>
</Base>

<style>
  .prose { max-width: 760px; display: grid; gap: var(--space-6); padding-left: calc(var(--gutter) + 1.2em); }
  .item { gap: var(--space-2); }
  .h3 { font-size: var(--h3); }
  a { overflow-wrap: anywhere; }
</style>
