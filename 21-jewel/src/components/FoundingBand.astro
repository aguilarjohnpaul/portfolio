---
import { spotsOpen, type HomeData, type SiteData } from '../lib/content';
import SpotMeter from './SpotMeter.astro';
interface Props { founding: HomeData['founding']; site: SiteData }
const { founding, site } = Astro.props;
const full = spotsOpen(site) === 0;
---
<section id="founding" class="section band" aria-labelledby="founding-h">
  <div class="container inner">
    <div class="intro">
      <p class="eyebrow">{founding.eyebrow}</p>
      <h2 id="founding-h">{founding.heading}</h2>
      <p class="body">{founding.body}</p>
      <SpotMeter site={site} />
    </div>
    <div>
      <a class="btn cta" href={founding.button.href} data-event="cta_click" data-prop-location="home-founding" data-prop-target={founding.button.href}>
        {full ? site.spots.waitlist : founding.button.label}
      </a>
    </div>
  </div>
</section>

<style>
  .band { background: var(--band-bg); color: var(--band-fg); }
  .band h2, .band h3 { color: var(--band-fg); }
  .band .eyebrow { color: var(--band-accent); }
  .inner { display: grid; gap: var(--space-6); }
  .intro { display: grid; gap: var(--space-4); }
  .intro .eyebrow { margin-bottom: 0; }
  .body { color: var(--band-muted); font-size: var(--lead); }
  .cta { background: var(--band-fg); color: var(--band-bg); }
  .cta:hover { filter: brightness(0.94); }
  .band :focus-visible { outline-color: var(--band-accent); }
</style>
