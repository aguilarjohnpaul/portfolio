---
import type { SiteData } from '../lib/content';
interface Props { footer: SiteData['footer'] }
const { footer } = Astro.props;
---
<fieldset class="theme-toggle">
  <legend>{footer.theme_label}</legend>
  <div class="options">
    {footer.theme_options.map((o) => (
      <label>
        <input type="radio" name="theme" value={o.value} checked={o.value === 'system'} />
        <span>{o.label}</span>
      </label>
    ))}
  </div>
</fieldset>

<style>
  .theme-toggle { border: 0; padding: 0; display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  legend { float: left; font-size: var(--small); color: var(--muted); margin-right: var(--space-3); }
  .options { display: inline-flex; border: 1px solid var(--line); border-radius: var(--radius-btn); overflow: hidden; }
  label { position: relative; }
  input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  span {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-4);
    font-size: var(--small); font-weight: 600; color: var(--muted);
  }
  label + label span { border-left: 1px solid var(--line); }
  input:checked + span { background: var(--btn-bg); color: var(--btn-fg); }
  input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: -4px; }
</style>

<script>
  import { track } from '../lib/analytics';
  const root = document.documentElement;
  const inputs = document.querySelectorAll<HTMLInputElement>('.theme-toggle input');
  const current = root.dataset.theme ?? 'system';
  inputs.forEach((i) => {
    i.checked = i.value === current;
    i.addEventListener('change', () => {
      const t = i.value;
      if (t === 'system') delete root.dataset.theme;
      else root.dataset.theme = t;
      try {
        if (t === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', t);
      } catch {}
      track('theme_toggle', { theme: t });
    });
  });
</script>
