---
import type { HomeData } from '../lib/content';
interface Props { cta: HomeData['scorecard_cta'] }
const { cta } = Astro.props;
---
<section id="scorecard" class="section section-surface" aria-labelledby="sc-h">
  <div class="container inner">
    <h2 id="sc-h">{cta.heading}</h2>
    <p class="lead">{cta.body}</p>
    <div><a class="btn btn-primary" href={cta.button.href}>{cta.button.label}</a></div>
  </div>
</section>

<style>
  .inner { display: grid; gap: var(--space-4); justify-items: center; text-align: center; }
  .inner p { margin-inline: auto; }
</style>
