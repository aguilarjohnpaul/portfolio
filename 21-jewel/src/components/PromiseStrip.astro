---
import type { HomeData } from '../lib/content';
interface Props { promise: HomeData['promise'] }
const { promise } = Astro.props;
---
<section class="promise" aria-label={promise.label}>
  <ul role="list" class="container items">
    {promise.items.map((t) => (
      <li>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span>{t}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .promise { background: var(--band-bg); color: var(--band-fg); padding-block: var(--space-6); }
  .items { display: grid; gap: var(--space-3) var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .items li { display: flex; gap: var(--space-2); align-items: center; font-weight: 600; max-width: none; }
  svg { flex: none; color: var(--band-accent); }
</style>
