---
import type { HomeData } from '../lib/content';
import Headshot from './Headshot.astro';
interface Props { about: HomeData['about'] }
const { about } = Astro.props;
---
<section id="about" class="section" aria-labelledby="about-h">
  <div class="container inner">
    <Headshot photo={about.photo} alt={about.photo_alt} />
    <div class="stack">
      <h2 id="about-h">{about.heading}</h2>
      {about.paragraphs.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
      <p><a class="more" href={about.link.href} data-event="cta_click" data-prop-location="home-about" data-prop-target={about.link.href}>{about.link.label}</a></p>
    </div>
  </div>
</section>

<style>
  .inner { display: grid; gap: var(--space-7); align-items: center; }
  .lead { color: var(--ink); }
  .more { font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  @media (min-width: 760px) { .inner { grid-template-columns: 360px 1fr; } }
</style>
