---
import type { HomeData } from '../lib/content';
interface Props { pains: HomeData['pains'] }
const { pains } = Astro.props;
---
<section class="section section-surface" aria-labelledby="pains-h">
  <div class="container">
    <h2 id="pains-h" class="section-head">{pains.heading}</h2>
    <ul role="list" class="pains">
      {pains.items.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<style>
  .pains { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .pains li {
    background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-5); font-weight: 500; font-size: var(--lead); line-height: 1.4;
  }
</style>
