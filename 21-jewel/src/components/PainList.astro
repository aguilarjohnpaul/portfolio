---
import type { HomeData } from '../lib/content';
interface Props { pains: HomeData['pains'] }
const { pains } = Astro.props;
---
<section class="section section-surface" aria-labelledby="pains-h">
  <div class="container">
    <h2 id="pains-h" class="section-head">{pains.heading}</h2>
    <ul role="list" class="grid carousel" tabindex="0" aria-labelledby="pains-h">
      {pains.items.map((p) => (
        <li class="stack pain">
          <h3>{p.title}</h3>
          <p class="muted">{p.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @media (max-width: 759.98px) {
    .pain { background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius-card); padding: var(--space-5); }
  }
</style>
