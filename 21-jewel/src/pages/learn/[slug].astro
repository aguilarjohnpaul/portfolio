---
// One guide or quick answer (Change 03 §6.3). Drafts never build.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import FAQ from '../../components/FAQ.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { doc, guides, readMinutes } from '../../lib/content';
import { articleLd, breadcrumbs, faqPage } from '../../lib/schema';

export async function getStaticPaths() {
  const list = await guides();
  return list.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
type Entry = Awaited<ReturnType<typeof guides>>[number];
const { entry } = Astro.props as { entry: Entry };
const [site, hub, pages, all, inds] = await Promise.all([doc('site'), doc('learnHub'), doc('pages'), guides(), doc('industries')]);
const { Content } = await render(entry);
const d = entry.data;
const path = `/learn/${entry.id}`;
const mins = readMinutes(entry.body ?? '');
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const titleFor = (href: string) => {
  const g = all.find((e) => `/learn/${e.id}` === href);
  if (g) return g.data.title;
  const map: Record<string, string> = { '/pricing': 'Pricing', '/audit': 'Free Local Search Audit', '/services/get-found': 'Get Found Setup', '/services/get-chosen': 'Get Chosen Setup', '/services/keep-ranking': 'Keep Ranking' };
  if (map[href]) return map[href];
  const m = href.match(/^\/industries\/([a-z-]+)$/);
  const ind = m ? inds.industries.find((i) => i.slug === m[1]) : undefined;
  return ind ? `Local search for ${ind.name.toLowerCase()}` : href;
};
const related = d.related.filter((href) => href !== path);
const faq = site.flags.showFaq ? d.faqs : [];
const short = d.seo_title ?? d.title;
const seo = { title: short.length > 44 ? short : `${short} · 21 Jewel Advisory`, description: d.description.slice(0, 160) };
const jsonLd = [
  articleLd(site, { path, title: d.title, description: d.description, published: d.published.toISOString(), updated: d.updated.toISOString(), author: hub.author }),
  breadcrumbs(site, [{ name: hub.heading, path: '/learn' }, { name: d.title, path }]),
  ...(faq.length ? [faqPage(faq)] : []),
];
---
<Base page="learn" seo={seo} jsonLd={jsonLd}>
  <Breadcrumbs trail={[{ name: hub.heading, path: '/learn' }, { name: d.title }]} />
  <div class="container"><article class="article" data-learn>
    <header class="head stack">
      <p class="eyebrow">{d.kind === 'guide' ? hub.labels.guide : hub.labels.answer} · {mins} {hub.labels.minutes}</p>
      <h1>{d.title}</h1>
      <p class="small muted">{hub.labels.updated}: <time datetime={d.updated.toISOString().slice(0, 10)}>{fmt(d.updated)}</time></p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <AuthorBox author={hub.author} photo={pages.about.photo} by={hub.labels.by} />
    {related.length > 0 && (
      <nav class="related" aria-label={hub.labels.related}>
        <p class="micro">{hub.labels.related}</p>
        <ul role="list">{related.map((href) => <li><a href={href}>{titleFor(href)}</a></li>)}</ul>
      </nav>
    )}
  </article></div>
  {faq.length > 0 && <FAQ heading={hub.labels.faq} items={faq} />}
  <CtaBlock site={site} heading={hub.cta.heading} body={hub.cta.body} label={hub.cta.label} callLabel={hub.cta.call_label} location="learn-article" />
</Base>

<style>
  .article { display: grid; gap: var(--space-6); padding-block: var(--space-5) var(--section); max-width: 820px; }
  .head { gap: var(--space-3); }
  .head .eyebrow { margin-bottom: 0; }
  .prose { display: grid; gap: var(--space-4); font-size: 17px; line-height: 1.65; }
  .prose :global(h2) { font-size: var(--h3); margin-top: var(--space-4); }
  .prose :global(h3) { font-size: 20px; margin-top: var(--space-2); }
  .prose :global(p), .prose :global(li) { max-width: 68ch; }
  .prose > :global(p:first-of-type) { font-size: var(--lead); color: var(--ink); }
  .prose :global(ol), .prose :global(ul) { padding-left: 1.3em; display: grid; gap: var(--space-2); }
  .prose :global(blockquote) { border-left: 3px solid var(--accent); padding: var(--space-2) var(--space-4); background: var(--surface); border-radius: 0 var(--radius-btn) var(--radius-btn) 0; color: var(--muted); }
  .prose :global(code) { font-size: 0.9em; background: var(--surface); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--line); overflow-wrap: anywhere; }
  .prose :global(a) { font-weight: 500; }
  .related { display: grid; gap: var(--space-2); border-top: 1px solid var(--line); padding-top: var(--space-5); }
  .related ul { display: grid; gap: var(--space-1); }
  .related a { min-height: 36px; display: inline-flex; align-items: center; font-weight: 500; }
</style>

<script>
  import { track } from '../../lib/analytics';
  // learn_read at 50% and 90% of the article body, once each.
  const el = document.querySelector<HTMLElement>('[data-learn]');
  if (el) {
    const hit = new Set<number>();
    const check = () => {
      const r = el.getBoundingClientRect();
      const read = Math.min(1, Math.max(0, (innerHeight - r.top) / r.height));
      for (const m of [50, 90]) if (read * 100 >= m && !hit.has(m)) { hit.add(m); track('learn_read', { percent: m }); }
      if (hit.size === 2) removeEventListener('scroll', check);
    };
    addEventListener('scroll', check, { passive: true });
  }
</script>
