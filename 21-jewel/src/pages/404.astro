---
import Base from '../layouts/Base.astro';
import { doc } from '../lib/content';
const t = (await doc('pages')).notfound;
---
<Base page="notfound" noindex>
  <div class="container page-head section">
    <h1>{t.heading}</h1>
    <p class="lead">{t.body}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/review" data-event="cta_click" data-prop-location="404" data-prop-target="/review">{t.review}</a>
      <a class="btn btn-ghost" href="/">{t.home}</a>
    </div>
  </div>
</Base>
