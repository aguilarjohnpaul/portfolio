---
import Base from '../layouts/Base.astro';
import ReviewForm from '../components/review/ReviewForm.astro';
import { doc } from '../lib/content';
import { turnstileSiteKey } from '../lib/turnstile-key';
const r = (await doc('pages')).review;
---
<Base page="review">
  <div class="container review">
    <div class="intro stack">
      <h1>{r.heading}</h1>
      <p class="lead">{r.intro}</p>
      <h2 class="h3">{r.how_heading}</h2>
      <ol class="steps">{r.steps.map((s) => <li>{s}</li>)}</ol>
      <p class="capacity">{r.capacity}</p>
    </div>
    <ReviewForm form={r.form} errors={r.errors} siteKey={turnstileSiteKey()} />
  </div>
</Base>

<style>
  .review { display: grid; gap: var(--space-7); padding-block: var(--space-8) var(--section); align-items: start; }
  .intro { gap: var(--space-4); }
  .h3 { font-size: var(--h3); margin-top: var(--space-3); }
  .steps { padding-left: 1.3em; display: grid; gap: var(--space-2); }
  .capacity { font-weight: 600; color: var(--accent-text); }
  @media (min-width: 960px) { .review { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); } }
</style>
