---
import Base from '../layouts/Base.astro';
import Headshot from '../components/Headshot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { calHref, doc } from '../lib/content';
import { breadcrumbs, personLd } from '../lib/schema';
const [site, pages, hub] = await Promise.all([doc('site'), doc('pages'), doc('learnHub')]);
const a = pages.about;
const cal = calHref(site);
const jsonLd = [personLd(site, hub.author), breadcrumbs(site, [{ name: 'About', path: '/about' }])];
---
<Base page="about" jsonLd={jsonLd}>
  <Breadcrumbs trail={[{ name: 'About' }]} />
  <section class="container about">
    <Headshot photo={a.photo} alt={a.photo_alt} eager />
    <div class="stack text">
      <h1>{a.heading}</h1>
      <p class="lead">{a.intro}</p>
      {a.paragraphs.map((p) => <p>{p}</p>)}
      <h2 class="h3">{a.differently_heading}</h2>
      <ul class="list">{a.differently.map((d) => <li>{d}</li>)}</ul>
    </div>
  </section>
  <section class="section section-surface" aria-labelledby="values-h">
    <div class="container">
      <h2 id="values-h" class="section-head">{a.values_heading}</h2>
      <ul role="list" class="grid">
        {a.values.map((v) => <li class="stack"><h3>{v.title}</h3><p class="muted">{v.body}</p></li>)}
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="container cta btn-row">
      <a class="btn btn-primary" href={a.button.href} data-event="cta_click" data-prop-location="about" data-prop-target={a.button.href}>{a.button.label}</a>
      <a class="btn btn-ghost" href={cal} data-event="cta_click" data-prop-location="about" data-prop-target="cal">{a.book_label}</a>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; gap: var(--space-7); padding-block: var(--space-6) var(--section); align-items: start; }
  .text { gap: var(--space-4); }
  .h3 { font-size: var(--h3); margin-top: var(--space-3); }
  .cta { display: flex; justify-content: center; }
  @media (min-width: 760px) { .about { grid-template-columns: 360px 1fr; } }
</style>
