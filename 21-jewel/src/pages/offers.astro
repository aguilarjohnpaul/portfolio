---
import Base from '../layouts/Base.astro';
import OfferDetail from '../components/OfferDetail.astro';
import AddOns from '../components/AddOns.astro';
import FAQ from '../components/FAQ.astro';
import { calHref, doc, ladder } from '../lib/content';
import { faqPage } from '../lib/schema';

const [site, data, faqs] = await Promise.all([doc('site'), doc('offers'), doc('faqs')]);
const faq = faqs.pages.pricing ?? [];
const cal = calHref(site);
const { showFaq, showFounding } = site.flags;
---
<Base page="offers" jsonLd={showFaq && faq.length ? [faqPage(faq)] : []}>
  <div class="container page-head">
    <h1>{data.page.heading}</h1>
    <p class="lead">{data.page.intro}</p>
  </div>
  <section class="section">
    <div class="container offers">
      {ladder(data).map((o) => <OfferDetail offer={o} labels={data.page.labels} cal={cal} showFounding={showFounding} />)}
      <AddOns heading={data.page.addons_heading} addons={data.addons} level="h2" />
      <div class="card dont">
        <h2 class="h3">{data.page.dont_do.heading}</h2>
        <p>{data.page.dont_do.body}</p>
      </div>
    </div>
  </section>
  {showFaq && faq.length > 0 && <FAQ heading={faqs.heading} items={faq} />}
</Base>

<style>
  .offers { display: grid; gap: var(--space-5); max-width: 960px; }
  .dont { display: grid; gap: var(--space-3); }
  .h3 { font-size: var(--h3); }
</style>

<script>
  import { track } from '../lib/analytics';
  // offer_view: fire once per offer when its section scrolls into view.
  const seen = new Set<string>();
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const id = (e.target as HTMLElement).dataset.offerView!;
      if (e.isIntersecting && !seen.has(id)) { seen.add(id); track('offer_view', { offer_id: id }); }
    }
  }, { threshold: 0.4 });
  document.querySelectorAll('[data-offer-view]').forEach((el) => io.observe(el));
</script>
