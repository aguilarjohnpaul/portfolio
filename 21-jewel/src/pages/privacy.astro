---
import Base from '../layouts/Base.astro';
import { doc } from '../lib/content';
const [site, pages] = await Promise.all([doc('site'), doc('pages')]);
const p = pages.privacy;
const updated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/Chicago' });
---
<Base page="privacy">
  <div class="container page-head">
    <h1>{p.heading}</h1>
    <p class="small muted">{p.updated_label}: {updated}</p>
    <p class="lead">{p.intro}</p>
  </div>
  <section class="section">
    <div class="container stack prose">
      {p.services.map((s) => (
        <div class="stack item">
          <h2 class="h3">{s.name}</h2>
          <p>{s.body}</p>
        </div>
      ))}
      <p>{p.storage}</p>
      <p>{p.deletion} <a href={`mailto:${site.brand.email}`} data-event="email_click" data-prop-location="privacy">{site.brand.email}</a> {p.deletion_suffix}</p>
    </div>
  </section>
</Base>

<style>
  .prose { max-width: 760px; gap: var(--space-6); }
  .item { gap: var(--space-2); }
  .h3 { font-size: var(--h3); }
  a { overflow-wrap: anywhere; }
</style>
