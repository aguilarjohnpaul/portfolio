---
// The free Local Search Audit (Change 03 §6.4). No sticky bar here: the form is the page.
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuditForm from '../components/audit/AuditForm.astro';
import FAQ from '../components/FAQ.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { doc } from '../lib/content';
import { breadcrumbs, faqPage } from '../lib/schema';
import { turnstileSiteKey } from '../lib/turnstile-key';
const [site, pages, faqs] = await Promise.all([doc('site'), doc('pages'), doc('faqs')]);
const a = pages.audit;
const faq = site.flags.showFaq ? (faqs.pages.audit ?? []) : [];
const jsonLd = [breadcrumbs(site, [{ name: a.heading, path: '/audit' }]), ...(faq.length ? [faqPage(faq)] : [])];
---
<Base page="audit" jsonLd={jsonLd} stickyBar={false}>
  <Breadcrumbs trail={[{ name: a.heading }]} />
  <div class="container audit">
    <div class="head stack">
      <h1>{a.heading}</h1>
      <p class="lead answer-first">{a.intro}</p>
    </div>
    <AuditForm form={a.form} errors={a.errors} siteKey={turnstileSiteKey()} />
    <div class="intro stack">
      <h2 class="h3">{a.get_heading}</h2>
      <ul class="list">{a.get.map((g) => <li>{g}</li>)}</ul>
      <h2 class="h3">{a.how_heading}</h2>
      <ol class="steps">{a.steps.map((s) => <li>{s}</li>)}</ol>
      <h2 class="h3">{a.need_heading}</h2>
      <p>{a.need}</p>
      <p class="capacity">{a.capacity}</p>
      <div class="phone">
        <h2 class="h3">{a.phone_heading}</h2>
        <p><a class="text-link" href={`tel:${site.brand.phone_href}`} data-event="call_click" data-prop-location="audit">{a.phone_label} {site.brand.phone}</a></p>
      </div>
      <TrustStrip trust={site.trust} />
    </div>
  </div>
  {faq.length > 0 && <FAQ heading={faqs.heading} items={faq} />}
</Base>

<style>
  .audit { display: grid; gap: var(--space-6); padding-block: var(--space-6) var(--section); align-items: start; }
  .head, .intro { gap: var(--space-4); }
  .h3 { font-size: var(--h3); margin-top: var(--space-3); }
  .intro .h3:first-child { margin-top: 0; }
  .steps { padding-left: 1.3em; display: grid; gap: var(--space-2); }
  .capacity { font-weight: 600; color: var(--accent-text); }
  .text-link { font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  @media (min-width: 960px) {
    .audit { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); grid-template-rows: auto 1fr; }
    .audit > :global(form) { grid-column: 2; grid-row: 1 / span 2; }
    .head { grid-column: 1; grid-row: 1; }
    .intro { grid-column: 1; grid-row: 2; }
  }
</style>
