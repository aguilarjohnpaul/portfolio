# Build-time public keys. In Cloudflare Pages, set these as environment variables.
# Optional. Overrides the Google Analytics 4 ID built into src/lib/analytics.ts (G-ZMJHTN6297).
PUBLIC_GA_ID=
# Cloudflare test key (always passes). Replace with your real site key.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Content Sheet (Change 03 §8, docs/google-sheet-content-setup.md). Leave unset to build from YAML only.
SHEET_CONTENT_ID=
# SHEET_CONTENT_OFF=1 skips the Sheet for a local build.
