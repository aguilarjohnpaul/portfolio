# Cloudflare Pages headers. The script hash placeholder below is filled in by scripts/csp.mjs after each build.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{SCRIPT_HASHES}} https://us-assets.i.posthog.com https://challenges.cloudflare.com https://tally.so; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tally.so; font-src 'self'; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com https://challenges.cloudflare.com https://tally.so; frame-src https://challenges.cloudflare.com https://tally.so https://cal.com https://app.cal.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/scorecard-data.json
  Cache-Control: public, max-age=300
